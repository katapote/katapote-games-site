# Copy to .env for local use. In production set these in
# Cloudflare Pages → Settings → Environment variables.
# None of these are secrets: they end up in public HTML.

# Public URL of the site (no trailing slash)
SITE_URL=https://katapote-games.example

# Cloudflare Web Analytics beacon token (page views only).
# Leave empty when you enable Web Analytics from the Pages dashboard
# (Cloudflare injects the beacon automatically in that case).
PUBLIC_CF_BEACON_TOKEN=

# Custom-event provider: none | plausible | zaraz | ga4
PUBLIC_ANALYTICS_PROVIDER=none
# plausible: the domain registered in Plausible (e.g. katapote.games)
PUBLIC_PLAUSIBLE_DOMAIN=
# plausible: script URL (change only if self-hosting)
PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.manual.js
# ga4: measurement id (G-XXXXXXX)
PUBLIC_GA4_ID=

# Set to 1 if Web Analytics is enabled from the Cloudflare Pages dashboard
# (no token needed). Only used so the Privacy Policy lists it correctly.
PUBLIC_CF_WEB_ANALYTICS=
