---
import type { Locale } from '../config/types';
import { activeSocials, site } from '../config/site';
import { l, useT } from '../i18n/ui';
import SocialIcon from './SocialIcon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
---

<section class="section" aria-labelledby="about-title">
  <div class="container about">
    <h2 id="about-title" class="section-title">{t('about.heading')}</h2>
    <div class="about__card">
      <p class="about__name">{l(site.developer.name, locale)}</p>
      <p class="about__bio">{l(site.developer.bio, locale)}</p>
      {
        activeSocials.length > 0 && (
          <ul class="about__links">
            {activeSocials.map((s) => (
              <li>
                <a class="btn btn--ghost btn--small" href={s.url} target="_blank" rel="noopener" data-track={s.event} data-track-location="about">
                  <SocialIcon id={s.id} size={16} />
                  {s.id === 'x' ? `${t('about.follow')} X` : s.label}
                  <span class="sr-only">{t('newTab')}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</section>

<style>
  .about__card {
    padding: 1.25rem;
    border-left: 3px solid var(--c-accent);
    background: var(--c-surface);
    border-radius: 0 var(--r-1) var(--r-1) 0;
  }
  .about__name {
    margin: 0;
    font-family: var(--f-hand);
    font-size: 1.6rem;
  }
  .about__bio {
    margin: 0.4rem 0 1rem;
    max-width: 40rem;
  }
  .about__links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }
</style>
