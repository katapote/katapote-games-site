---
import '@fontsource/permanent-marker/latin-400.css';
import '../styles/global.css';
import type { Locale } from '../config/types';
import { site } from '../config/site';
import { l, localePath, locales, useT } from '../i18n/ui';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  locale: Locale;
  /** Locale-neutral path, e.g. '/' or '/privacy/'. */
  path: string;
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Only the Japanese (default) home page: send visitors who picked EN before to /en/. */
  autoLanguage?: boolean;
}

const { locale, path, title, description, noindex = false, autoLanguage = false } = Astro.props;
const t = useT(locale);
const pageTitle = title ? `${title} | ${site.name}` : l(site.defaultTitle, locale);
const pageDescription = description ?? l(site.description, locale);
const canonical = new URL(localePath(locale, path), Astro.site).href;
const ogImage = new URL(site.ogImage, Astro.site).href;
const alternates = locales.map((loc) => ({ loc, href: new URL(localePath(loc, path), Astro.site).href }));
const cfBeacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const provider = import.meta.env.PUBLIC_ANALYTICS_PROVIDER || 'none';
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
const plausibleSrc = import.meta.env.PUBLIC_PLAUSIBLE_SRC || 'https://plausible.io/js/script.manual.js';
const ga4Id = import.meta.env.PUBLIC_GA4_ID;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.loc} href={a.href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={alternates[0]!.href} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#110e17" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale === 'ja' ? 'ja_JP' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'ja' ? 'en_US' : 'ja_JP'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={site.xHandle} />
    <meta name="twitter:creator" content={site.xHandle} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    {
      autoLanguage && (
        <script is:inline>
          // Japanese is the default. Only a visitor who chose EN with the switch
          // before (stored in localStorage) is sent to /en/.
          (function () {
            try {
              if (localStorage.getItem('kg_lang') === 'en') {
                location.replace('/en/' + location.search + location.hash);
              }
            } catch (e) {}
          })();
        </script>
      )
    }

    {
      provider === 'plausible' && plausibleDomain && (
        <>
          <script is:inline>
            window.plausible = window.plausible || function () { (window.plausible.q = window.plausible.q || []).push(arguments); };
          </script>
          <script is:inline defer data-domain={plausibleDomain} src={plausibleSrc} />
        </>
      )
    }
    {
      provider === 'ga4' && ga4Id && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`} />
          <script is:inline define:vars={{ ga4Id }}>
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () { window.dataLayer.push(arguments); };
            window.gtag('js', new Date());
            window.gtag('config', ga4Id, { send_page_view: false, anonymize_ip: true });
          </script>
        </>
      )
    }
    {
      cfBeacon && (
        <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cfBeacon })} />
      )
    }
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('nav.skip')}</a>
    <Header locale={locale} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      import '../scripts/analytics';
    </script>
  </body>
</html>
