---
import Base from '../layouts/Base.astro';
import { useT } from '../i18n/ui';
const t = useT('en');
---

<Base locale="en" path="/" title={t('notfound.title')} noindex>
  <section class="section">
    <div class="container prose">
      <h1>{t('notfound.title')}</h1>
      <p>{t('notfound.body')}</p>
      <p><a class="btn btn--small" href="/">{t('notfound.back')}</a></p>
    </div>
  </section>
</Base>
